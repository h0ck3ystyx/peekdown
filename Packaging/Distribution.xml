<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Peekdown</title>
    <welcome file="Welcome.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="12.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="peekdown"/>
    </choices-outline>
    <choice id="peekdown" title="Peekdown" description="Markdown previews and thumbnails in Finder" visible="false">
        <pkg-ref id="com.markdownpreview.installer"/>
    </choice>
    <pkg-ref id="com.markdownpreview.installer">Peekdown-component.pkg</pkg-ref>
</installer-gui-script>
